function getResearch(q){
  q=q.toLowerCase().trim();
  let exact=marketResearch[q];
  if(exact)return exact;
  let key=Object.keys(marketResearch).find(k=>q.includes(k)||k.includes(q));
  if(key)return marketResearch[key];
  return {
    markets:[
      {country:'UAE',priority:'High',type:'Research',reason:'Potential market — verify current import demand'},
      {country:'Saudi Arabia',priority:'High',type:'Research',reason:'Potential market — verify current import demand'},
      {country:'UK',priority:'Medium',type:'Research',reason:'Potential market — verify current import demand'},
      {country:'Netherlands',priority:'Medium',type:'Research',reason:'Potential market — verify current import demand'}
    ],importers:[]
  };
}
let currentResearch=null;
function runMarketSearch(){
  let q=(marketSearch.value||'').trim();
  if(!q){alert('Please enter a product name.');return}
  currentResearch={product:q,data:getResearch(q)};
  marketEmpty.style.display='none';marketResults.style.display='block';
  searchedProduct.textContent=q.length>15?q.slice(0,14)+'…':q;
  marketCount.textContent=currentResearch.data.markets.length;
  importerCount.textContent=currentResearch.data.importers.length;
  highMarkets.textContent=currentResearch.data.markets.filter(x=>x.priority==='High').length;
  importerSubtitle.textContent=`${currentResearch.data.importers.length} matching record${currentResearch.data.importers.length===1?'':'s'}`;
  marketTable.innerHTML=`<table class="table"><thead><tr><th>Country</th><th>Priority</th><th>Product Type</th><th>Why target it</th><th></th></tr></thead><tbody>${currentResearch.data.markets.map(m=>`<tr><td><strong>${esc(m.country)}</strong></td><td>${priority(m.priority)}</td><td>${esc(m.type)}</td><td>${esc(m.reason)}</td><td><button class="btn btn-light" onclick="searchCountry('${esc(m.country)}')">Find importers</button></td></tr>`).join('')}</tbody></table>`;
  renderImporters(currentResearch.data.importers);
}
function renderImporters(list){
  importerTable.innerHTML=list.length?`<table class="table"><thead><tr><th>Company</th><th>Country</th><th>Type</th><th>Contact</th><th>Job</th><th>Email</th><th>Website</th><th>Products</th><th>Score</th><th></th></tr></thead><tbody>${list.map((x,i)=>`<tr><td><strong>${esc(x.company)}</strong></td><td>${esc(x.country)}<br><span style="color:#8a958f">${esc(x.city)}</span></td><td>${esc(x.type)}</td><td>${esc(x.contact)}</td><td>${esc(x.job)}</td><td>${esc(x.email)}</td><td>${esc(x.website)}</td><td>${esc(x.products)}</td><td><span class="badge ${x.score>=90?'green':x.score>=80?'blue':'gray'}">${x.score}/100</span></td><td><button class="btn btn-primary" onclick="addResearchLead(${i})">+ Lead</button></td></tr>`).join('')}</tbody></table>`:'<div class="empty">No importer records are currently available for this product. Use “Search web for importers” to continue research.</div>';
}
function searchCountry(country){
  if(!currentResearch)return;
  let q=currentResearch.product;
  openWebResearch('importers',q,country);
}
function openWebResearch(kind,q,country){
  q=q||currentResearch?.product||marketSearch.value||'agricultural products';
  let query=kind==='trade'?`${q} import market countries importers trade data`: `${q} importer distributor wholesaler ${country||''}`;
  window.open('https://www.google.com/search?q='+encodeURIComponent(query),'_blank','noopener');
}
function addResearchLead(i){
  let x=currentResearch?.data.importers?.[i];if(!x)return;
  if(leads.some(l=>l.email&&x.email&&l.email.toLowerCase()===x.email.toLowerCase())){alert('This company is already in Leads.');return}
  leads.push({id:Date.now(),company:x.company,country:x.country,contact:x.contact,email:x.email,products:x.products,owner:currentUser.id,status:'New Lead',next:''});
  save('leads',leads);log('Added research company as lead',x.company);
  alert(`${x.company} was added to your Leads.`);
  renderLeads();renderDashboard();
}
function saveMarketSearch(){
  if(!currentResearch){alert('Search for a product first.');return}
  let saved=load('marketSearches',[]);
  saved.unshift({id:Date.now(),product:currentResearch.product,date:new Date().toLocaleString(),user:currentUser.name,markets:currentResearch.data.markets.length});
  save('marketSearches',saved);log('Saved market research',currentResearch.product);alert('Research saved.');
}

