 ${selectField('priority','Priority',['High','Medium','Low'],c.priority)}${selectField('owner','Owner',users.filter(u=>u.role==='SALES').map(u=>u.id),c.owner,true)}${field('last','Last Contact',c.last,'date')}${field('next','Next Follow-up',c.next,'date')}
 </div><div class="modal-actions"><button type="button" class="btn btn-light" onclick="closeModal()">Cancel</button><button class="btn btn-primary">Save Customer</button></div></form>`;
 modalBg.classList.add('show');
 customerForm.onsubmit=e=>{e.preventDefault();let data=Object.fromEntries(new FormData(customerForm));if(currentUser.role!=='ADMIN')data.owner=currentUser.id;if(existing){Object.assign(existing,data);log('Updated customer',data.company)}else{data.id=Date.now();customers.push(data);log('Added customer',data.company)}save('customers',customers);closeModal();renderCustomers();renderDashboard()}
}
function field(id,label,val,type='text'){return `<div class="${id==='linkedin'?'':' '}"><label style="display:block;font-size:11px;font-weight:700;margin-bottom:5px">${label}</label><input name="${id}" type="${type}" value="${esc(val)}"></div>`}
function selectField(id,label,opts,val,isIds=false){let list=isIds?opts.map(x=>({v:x,t:ownerName(x)})):opts.map(x=>({v:x,t:x}));return `<div><label style="display:block;font-size:11px;font-weight:700;margin-bottom:5px">${label}</label><select name="${id}">${list.map(x=>`<option value="${esc(x.v)}" ${x.v===val?'selected':''}>${esc(x.t)}</option>`).join('')}</select></div>`}
function editCustomer(id){let c=customers.find(x=>x.id===id);if(c)openCustomerModal(c)}
function closeModal(){modalBg.classList.remove('show')}
function openLeadModal(){modal.innerHTML=`<div class="modal-head"><h2>Add Lead</h2><button class="close" onclick="closeModal()">×</button></div><form id="leadForm"><div class="form-grid">${field('company','Company Name','')}${field('country','Country','')}${field('contact','Contact Person','')}${field('email','Email','','email')}${field('products','Products Interested In','')}${field('next','Next Follow-up','','date')}</div><div class="modal-actions"><button type="button" class="btn btn-light" onclick="closeModal()">Cancel</button><button class="btn btn-primary">Save Lead</button></div></form>`;modalBg.classList.add('show');leadForm.onsubmit=e=>{e.preventDefault();let d=Object.fromEntries(new FormData(leadForm));d.id=Date.now();d.owner=currentUser.id;d.status='New Lead';leads.push(d);save('leads',leads);log('Added lead',d.company);closeModal();renderLeads();renderDashboard()}}
function convertLead(id){let l=leads.find(x=>x.id===id);if(!l)return;if(!confirm(`Convert ${l.company} to a customer?`))return;customers.push({id:Date.now(),company:l.company,country:l.country,city:'',type:'Importer',contact:l.contact,job:'',email:l.email,phone:'',linkedin:'',products:l.products,category:'Fresh',supplier:'',volume:'',packaging:'',market:'',status:'New Lead',owner:l.owner,last:new Date().toISOString().slice(0,10),next:l.next,priority:'Medium'});leads=leads.filter(x=>x.id!==id);save('customers',customers);save('leads',leads);log('Converted lead',l.company);renderLeads();renderDashboard()}
modalBg.onclick=e=>{if(e.target===modalBg)closeModal()};
let sid=sessionStorage.getItem('mscrm_user');if(sid){let u=users.find(x=>x.id===sid);if(u){currentUser=u;startApp()}}
